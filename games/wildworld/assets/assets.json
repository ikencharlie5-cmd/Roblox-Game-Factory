{
  "_note": "Wildworld uses code-built studded brick models (DECISIONS.md 2026-11-18). 'builder:' = code builder, 'viewport:' = ViewportFrame render, 'MISSING:' = no builder yet. No Creator Store/mesh asset IDs used.",
  "creatures": {
    "Lumibun": "builder:CreatureBlueprints.Lumibun",
    "Mossback": "builder:CreatureBlueprints.Mossback",
    "Emberfox": "builder:CreatureBlueprints.Emberfox",
    "Pebblehorn": "builder:CreatureBlueprints.Pebblehorn",
    "Thornstag": "builder:CreatureBlueprints.Thornstag"
  },
  "eggs_mutations": {
    "Egg": "builder:CreatureBuilder.BuildEgg",
    "GoldenEgg": "builder:CreatureBuilder.BuildEgg(mutations={Golden})",
    "EggShellHalves": "builder:Theme.Moments.Hatch",
    "CrystalShard": "builder:CreatureBuilder.Mutations.Apply(Crystal)",
    "GoldCrownPlate": "builder:CreatureBuilder.Mutations.Apply(Golden)"
  },
  "build_props": {
    "PadSmall": "builder:Theme.Props.PadSmall",
    "PadMedium": "builder:Theme.Props.PadMedium",
    "PadLarge": "builder:Theme.Props.PadLarge",
    "Fence": "builder:Theme.Props.Fence",
    "Path": "builder:Theme.Props.Path",
    "Bench": "builder:Theme.Props.Bench",
    "SnackStand": "builder:Theme.Props.SnackStand",
    "Lantern": "builder:Theme.Props.Lantern",
    "TreeOak": "builder:Theme.Props.TreeOak",
    "TreePine": "builder:Theme.Props.TreePine",
    "TreeMagic": "builder:Theme.Props.TreeMagic",
    "Bush": "builder:Theme.Props.Bush",
    "Flowers": "builder:Theme.Props.Flowers",
    "Rock": "builder:Theme.Props.Rock",
    "BigRock": "builder:Theme.Props.BigRock",
    "Log": "builder:Theme.Props.Log",
    "Burrow": "builder:Theme.Props.Burrow",
    "SandPatch": "builder:Theme.Props.SandPatch",
    "Sunspot": "builder:Theme.Props.Sunspot",
    "Pond": "builder:Theme.Props.Pond",
    "Waterfall": "builder:Theme.Props.Waterfall",
    "FoodBowl": "builder:Theme.Props.FoodBowl",
    "WaterTrough": "builder:Theme.Props.WaterTrough",
    "ShelterHut": "builder:Theme.Props.ShelterHut",
    "ToyBall": "builder:Theme.Props.ToyBall",
    "VipFountain": "builder:Theme.Props.VipFountain",
    "CrystalCluster": "builder:Theme.Props.CrystalCluster",
    "GrottoArch": "builder:Theme.Props.GrottoArch",
    "GlowShroom": "builder:Theme.Props.GlowShroom",
    "StarterArch": "builder:Theme.Props.StarterArch",
    "MossStatue": "builder:Theme.Props.MossStatue",
    "RainbowFlowers": "builder:Theme.Props.RainbowFlowers"
  },
  "world": {
    "WildHills": "builder:World.Terrain.Hill",
    "WildBoulders": "builder:Theme.Nature.Rock / World.Scatter.Sprinkle",
    "Clouds": "builder:Theme.Nature.Cloud / World.Sky.Clouds",
    "MeadowFlowers": "builder:Theme.Nature.FlowerPatch / World.Scatter.FlowerLine",
    "HubPlaza": "builder:World.Hub.Build(disc+heartTree)",
    "ShopStall": "builder:World.Hub.shopStall",
    "TopParksBoard": "builder:World.Hub.topParksBoard",
    "DailyChest": "builder:World.Hub.dailyChest",
    "PlotBorderSign": "builder:World.Plots.border+sign",
    "MeadowGateArch": "builder:World.Forest.arch",
    "LakeWaterfall": "builder:World.Terrain.Lake + World.Waterfall.Build",
    "VisitorNPC": "builder:client.Animation.Visitors.newVisitor"
  },
  "icons": {
    "Icon_Lumibun": "viewport:Kit.CreatureView(Lumibun)",
    "Icon_Mossback": "viewport:Kit.CreatureView(Mossback)",
    "Icon_Emberfox": "viewport:Kit.CreatureView(Emberfox)",
    "Icon_Pebblehorn": "viewport:Kit.CreatureView(Pebblehorn)",
    "Icon_Thornstag": "viewport:Kit.CreatureView(Thornstag)",
    "Icon_SpeciesSilhouette": "viewport:Kit.CreatureView(Silhouette=true)",
    "Icon_Egg": "builder:Theme.IconModels.Build(Egg)",
    "Icon_Coins": "builder:Theme.IconModels.Build(Coin)",
    "Icon_RP": "builder:Theme.IconModels.Build(RP)",
    "Icon_BaitBerry": "builder:Theme.IconModels.Build(Berry)",
    "Icon_BaitHoney": "builder:Theme.IconModels.Build(Honey)",
    "Icon_BaitStarfruit": "builder:Theme.IconModels.Build(Starfruit)",
    "Icon_PassVIP": "builder:Theme.IconModels.Build(VIP)",
    "Icon_PassExtraIncubator": "builder:Theme.IconModels.Build(ExtraIncubator)",
    "Icon_PassAutoFeeder": "builder:Theme.IconModels.Build(AutoFeeder)",
    "Icon_PassCrystalGrotto": "builder:Theme.IconModels.Build(CrystalGrotto)",
    "Icon_CoinPacks": "builder:Theme.IconModels.Build(CoinsSmall|CoinsMedium|CoinsLarge)",
    "Icon_StarterPack": "builder:Theme.IconModels.Build(StarterPack)",
    "Icon_BuildItems": "builder:Theme.Props.Build(itemId) (UI needs Kit.ModelView)",
    "Icon_InstantHatch": "builder:Theme.IconModels.Build(InstantHatch)"
  }
